<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <RootNamespace>KK_BetterSquirt</RootNamespace>
    <AssemblyName>KK_BetterSquirt</AssemblyName>
    <DefineConstants>$(DefineConstants);KK</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Core_BetterSquirt/AssemblyInfo.cs sets the assembly attributes -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <OutputPath>..\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugType>embedded</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>embedded</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ExtensibleSaveFormat.Koikatu" Version="16.8.1" ExcludeAssets="all" />
    <PackageReference Include="IllusionLibs.BepInEx" Version="5.4.20" />
    <PackageReference Include="IllusionLibs.BepInEx.Harmony" Version="2.9.0" />
    <PackageReference Include="IllusionLibs.Koikatu.Assembly-CSharp" Version="2019.4.27" />
    <PackageReference Include="IllusionLibs.Koikatu.Assembly-CSharp-firstpass" Version="2019.4.27" />
    <PackageReference Include="IllusionLibs.Koikatu.Sirenix.Serialization" Version="2019.4.27" />
    <PackageReference Include="IllusionLibs.Koikatu.UnityEngine" Version="5.6.2" />
    <PackageReference Include="IllusionLibs.Koikatu.UnityEngine.UI" Version="5.6.2" />
    <PackageReference Include="IllusionModdingAPI.KKAPI" Version="1.23.0" />
    <PackageReference Include="KoikatuCompatibilityAnalyzer" Version="1.1.0" />
  </ItemGroup>
  <Import Project="..\Core_BetterSquirt\Core_BetterSquirt.projitems" Label="Shared" />
  <!-- Run copy.bat only if it exists. MSBuild does the check, so the build also works on Linux -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="Exists('$(SolutionDir)copy.bat')">
    <Exec Command="&quot;$(SolutionDir)copy.bat&quot; &quot;$(TargetPath)&quot; &quot;$(TargetFileName)&quot;" />
  </Target>
</Project>
